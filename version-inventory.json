{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "src/B47ANCEDPCFramework/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDPCFramework/42/media/lua/shared/B47ANCEDPCFramework/Identity.lua",
      "pattern": "version='(?P<version>[^']+)'"
    },
    {
      "path": "README.md",
      "pattern": "Development version: (?P<version>\\S+)\\."
    },
    {
      "path": "docs/API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/ARCHITECTURE.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/TESTING.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/MOD_OVERVIEW.json",
      "pattern": "^  \"version\": \"(?P<version>[^\\\"]+)\""
    },
    {
      "path": "docs/UI_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/ROADMAP.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/CD_PROGRAM_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/MINESWEEPER.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/MINESWEEPER_MOOD.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/current/*.zip",
        "pattern": "B47ANCEDPCFramework-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "B47ANCEDPCFramework/42/mod.info",
            "pattern": "^modversion=(?P<version>[^\\r\\n]+)\\r?$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "src/B47ANCEDPCFramework/42/mod.info:versionMin",
      "reason": "PZ compatibility, not project version"
    },
    {
      "category": "compatibility",
      "reference": "Identity.lua apiVersion=1",
      "reason": "Independent application registration contract"
    },
    {
      "category": "compatibility",
      "reference": "UI.lua version=1; Assets.lua version=1; getAPIInfo()",
      "reason": "Independently versioned additive public UI and drawing-assets contracts, not project versions."
    },
    {
      "category": "compatibility",
      "reference": "CDPrograms.lua version=1; getAPIInfo().cdProgramVersion; consumer program version",
      "reason": "CD program contract and independently versioned consumer program data, not framework project versions."
    }
  ],
  "historical": []
}
